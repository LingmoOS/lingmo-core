[Unit]
Description=Lingmo locale generation

[Service]
Type=dbus
BusName=org.lingmo.Locales
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/lingmo-locales
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# locale.gen is replaced through a new file beside it.
ReadWritePaths=-/usr/lib/locale /etc
