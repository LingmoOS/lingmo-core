<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Lingmo</vendor>
  <vendor_url>https://github.com/lingmoos/lingmo-core</vendor_url>

  <action id="org.lingmo.locales.generate">
    <description>Prepare the system for a language</description>
    <message>Authentication is required to prepare the system for a language</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
