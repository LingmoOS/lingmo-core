<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.lingmo.Services.NightLight">
    <property name="enabled" type="b" access="read"/>
    <property name="temperature" type="d" access="read"/>
    <property name="schedule" type="i" access="read"/>
    <property name="customStart" type="i" access="read"/>
    <property name="customEnd" type="i" access="read"/>
    <property name="available" type="b" access="read"/>
    <property name="sunset" type="i" access="read"/>
    <property name="sunrise" type="i" access="read"/>
    <method name="setEnabled">
        <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="setTemperature">
        <arg name="temperature" type="d" direction="in"/>
    </method>
    <method name="setSchedule">
        <arg name="schedule" type="i" direction="in"/>
    </method>
    <method name="setCustomStart">
        <arg name="minutes" type="i" direction="in"/>
    </method>
    <method name="setCustomEnd">
        <arg name="minutes" type="i" direction="in"/>
    </method>
    <method name="setPreview">
        <arg name="preview" type="b" direction="in"/>
    </method>
    <signal name="enabledChanged">
        <arg name="enabled" type="b"/>
    </signal>
    <signal name="temperatureChanged">
        <arg name="temperature" type="d"/>
    </signal>
    <signal name="scheduleChanged">
        <arg name="schedule" type="i"/>
    </signal>
    <signal name="customStartChanged">
        <arg name="minutes" type="i"/>
    </signal>
    <signal name="customEndChanged">
        <arg name="minutes" type="i"/>
    </signal>
    <signal name="availableChanged">
        <arg name="available" type="b"/>
    </signal>
    <signal name="sunsetChanged">
        <arg name="minutes" type="i"/>
    </signal>
    <signal name="sunriseChanged">
        <arg name="minutes" type="i"/>
    </signal>
  </interface>
</node>
