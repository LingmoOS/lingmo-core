#!/bin/sh
# Session management stays in core/session; it supervises lingmo-compositor.
export XDG_CURRENT_DESKTOP=Lingmo
export XDG_SESSION_DESKTOP=Lingmo
export DESKTOP_SESSION=Lingmo
export XDG_SESSION_TYPE=wayland
export WAYLAND_DISPLAY=lingmo-0
unset DISPLAY XAUTHORITY WAYLAND_SOCKET
exec /usr/bin/lingmo-session "$@"
